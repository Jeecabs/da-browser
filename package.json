{
  "name": "da-browser",
  "version": "0.2.2",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "description": "Pi browser-control tools powered by agent-browser.",
  "homepage": "https://jeecabs.github.io/pi-tooling/da-browser/",
  "repository": {
    "type": "git",
    "url": "https://github.com/Jeecabs/da-browser.git"
  },
  "keywords": [
    "pi-package",
    "browser-control",
    "agent-browser"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "scripts": {
    "preview:control": "node --experimental-strip-types scripts/preview-controlled-tab.mjs",
    "preview:tui": "node --experimental-strip-types scripts/preview-tui.mjs",
    "check": "tsc --noEmit",
    "test": "node --test --experimental-strip-types tests/*.test.ts",
    "test:e2e": "node --test --experimental-strip-types tests/pin-tab.e2e.ts"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "dependencies": {},
  "devDependencies": {
    "@earendil-works/pi-agent-core": "^1.0.0",
    "@earendil-works/pi-ai": "^1.0.0",
    "@earendil-works/pi-coding-agent": "^1.0.0",
    "@earendil-works/pi-tui": "^1.0.0",
    "@types/node": "^24.3.0",
    "typescript": "^5.9.2",
    "typebox": "1.3.27"
  },
  "pnpm": {
    "overrides": {
      "protobufjs@7": "^7.5.6",
      "@protobufjs/utf8": "^1.1.1",
      "undici@8": "^8.10.2",
      "ws@8": "^8.21.0",
      "brace-expansion@5": "^5.0.12"
    }
  }
}
