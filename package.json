{
  "name": "da-browser",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "description": "Pi browser-control tools powered by agent-browser.",
  "homepage": "https://jeecabs.github.io/pi-tooling/da-browser/",
  "repository": {
    "type": "git",
    "url": "https://github.com/Jeecabs/da-browser.git"
  },
  "keywords": [
    "pi-package",
    "browser-control",
    "agent-browser"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "preview:control": "node --experimental-strip-types scripts/preview-controlled-tab.mjs",
    "check": "tsc --noEmit",
    "test": "node --test --experimental-strip-types tests/*.test.ts",
    "test:e2e": "node --test --experimental-strip-types tests/pin-tab.e2e.ts"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "^0.78.1",
    "@earendil-works/pi-ai": "^0.78.1",
    "@earendil-works/pi-coding-agent": "^0.79.0",
    "@earendil-works/pi-tui": "^0.78.1",
    "typebox": "1.1.38"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "^0.78.1",
    "@earendil-works/pi-ai": "^0.78.1",
    "@earendil-works/pi-coding-agent": "^0.79.0",
    "@earendil-works/pi-tui": "^0.78.1",
    "@types/node": "^24.3.0",
    "typescript": "^5.9.2",
    "typebox": "1.1.38"
  }
}
