{
  "name": "lachlan-aa-pi-extensions",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "description": "Custom pi extensions, browser automation, process tools, and themes.",
  "keywords": [
    "pi-package"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts",
      "./src/supabase/index.ts",
      "./src/linear/index.ts",
      "./src/github/index.ts",
      "./src/fallow/index.ts",
      "./src/roo/index.ts",
      "./src/tmux-cx-pair/index.ts",
      "./src/html-artifacts/index.ts",
      "./src/watchtower.ts",
      "./src/vicecity/index.ts"
    ],
    "themes": [
      "./themes"
    ],
    "skills": [
      "./skills"
    ],
    "prompts": [
      "./prompts"
    ]
  },
  "scripts": {
    "check": "tsc --noEmit",
    "test": "node --test --experimental-strip-types tests/*.test.ts"
  },
  "peerDependencies": {
    "@mariozechner/pi-agent-core": "*",
    "@mariozechner/pi-ai": "*",
    "@mariozechner/pi-coding-agent": "*",
    "@mariozechner/pi-tui": "*",
    "@sinclair/typebox": "*"
  },
  "devDependencies": {
    "@mariozechner/pi-agent-core": "^0.68.1",
    "@mariozechner/pi-ai": "^0.68.1",
    "@mariozechner/pi-coding-agent": "^0.68.1",
    "@mariozechner/pi-tui": "^0.68.1",
    "@sinclair/typebox": "^0.34.0",
    "@types/node": "^24.3.0",
    "typescript": "^5.9.2"
  }
}
